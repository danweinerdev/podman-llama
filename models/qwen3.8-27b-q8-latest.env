# Model config: Qwen3.8-27B latest UD-Q8_K_XL -- separate A/B target.
#
# This intentionally does not replace models/qwen3.8-27b-q8.env. It targets the
# newly downloaded GGUF in /data/models/Qwen3.8-27B-GGUF and keeps a unique
# alias so both UD-Q8_K_XL builds can be tested independently.
#
# Qwen's prescribed thinking-mode sampling:
#   temp 1.0, top-p 0.95, top-k 20, min-p 0.0, presence 0.0, repeat 1.0
#
# This test variant is text-only, so it does not require an mmproj download.
#
# Download:
#   hf download unsloth/Qwen3.8-27B-GGUF \
#     --include "Qwen3.8-27B-UD-Q8_K_XL.gguf" \
#     --local-dir /data/models/Qwen3.8-27B-GGUF

# /data/models is mounted at /models inside the container.
: "${MODEL:=Qwen3.8-27B-GGUF/Qwen3.8-27B-UD-Q8_K_XL.gguf}"

LLAMA_ARGS+=(--temp 1.0 --top-p 0.95 --top-k 20 --min-p 0.0 --presence-penalty 0.0 --repeat-penalty 1.0)
LLAMA_ARGS+=(--alias qwen3.8-27b-q8-latest)
