# Model config: Qwen3.8-27B (UD-Q8_K_XL, single-file GGUF) -- model-intrinsic only.
#
# Unsloth Dynamic V3.0 8-bit quant, ~29.3 GiB single file. Architecture,
# sampling rationale, KV math and thinking-control notes: see
# models/qwen3.8-27b.env -- this file only swaps the weights (and the
# projector, F16 to match).
#
# WHY THIS QUANT: it is the largest Qwen3.8-27B that fits a SINGLE 31 GiB
# R9700 alongside a useful KV cache, so it avoids the inter-GPU traffic of a
# two-card split. On the dual-R9700 box, prefer BF16 across both cards when
# you want maximum quality and this when you want one card free.
#
# Download:
#   hf download unsloth/Qwen3.8-27B-GGUF \
#     --include "Qwen3.8-27B-UD-Q8_K_XL.gguf" \
#     --local-dir /data/models/Qwen3.8-27B

: "${MODEL:=Qwen3.8-27B/Qwen3.8-27B-UD-Q8_K_XL.gguf}"

LLAMA_ARGS+=(--temp 1.0 --top-p 0.95 --top-k 20 --min-p 0.0 --presence-penalty 0.0 --repeat-penalty 1.0)
LLAMA_ARGS+=(--mmproj "/models/Qwen3.8-27B/mmproj-F16.gguf")
LLAMA_ARGS+=(--alias qwen3.8-27b)
