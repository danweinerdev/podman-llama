# GPU-fit tuning: latest Qwen3.8-27B UD-Q6_K_XL on 2x R9700.
#
# Memory arithmetic vs ~62 GiB combined VRAM (text-only; no projector):
#   weights (25,299,061,664 bytes)       23.56 GiB
#   KV @ 262,144 tok, q8_0 K+V             ~8.5 GiB
#   compute buffers @ ubatch 512            ~1.5 GiB
#   --------------------------------------------------
#   total                                  ~33.6 GiB
#   arithmetic slack                       ~28.4 GiB
: "${CTX_SIZE:=262144}"
: "${UBATCH:=512}"

# The current Vulkan container rejected row mode in the latest test setup with
# "device Vulkan0 does not support split buffers". Use layer mode until the
# backend reports split-buffer support.
: "${SPLIT_MODE:=layer}"

# Initial display-card-biased baseline. This split is unmeasured for Q6 and
# should be verified before retuning.
TENSOR_SPLIT="${TENSOR_SPLIT:-0.6,1.4}"
