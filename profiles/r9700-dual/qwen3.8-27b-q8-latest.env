# GPU-fit tuning: latest Qwen3.8-27B UD-Q8_K_XL on 2x R9700.
#
# Separate A/B target for models/qwen3.8-27b-q8-latest.env. Benchmark this newly
# downloaded build before treating its performance as equivalent to the existing
# UD-Q8_K_XL target.
#
# Memory arithmetic vs ~62 GiB combined VRAM:
#   weights (31,457,991,680 bytes)       29.30 GiB
#   KV @ 262,144 tok, q8_0 K+V            8.5 GiB
#   compute buffers @ ubatch 512         ~1.5 GiB
#   ------------------------------------------------
#   total                                ~39.3 GiB; ~22.7 GiB slack
: "${CTX_SIZE:=262144}"
: "${UBATCH:=512}"

# The current Vulkan container rejects row mode while loading this GGUF with
# "device Vulkan0 does not support split buffers". Layer mode distributes whole
# layers without requiring Vulkan split buffers. Re-test row only after the
# backend reports split-buffer support.
: "${SPLIT_MODE:=layer}"

# Bias weights off the display-driving primary card, matching the measured Q8
# baseline. Verify VRAM use before retuning this newly downloaded build.
TENSOR_SPLIT="${TENSOR_SPLIT:-0.6,1.4}"
