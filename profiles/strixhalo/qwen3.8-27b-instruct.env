# GPU-fit tuning: Qwen3.8-27B instruct/non-thinking on Strix Halo.
#
# models/qwen3.8-27b-instruct.env uses UD-Q8_K_XL weights (29.3 GiB), not the
# BF16 that profiles/strixhalo/qwen3.8-27b.env budgets for, so the numbers
# differ from the flagship config:
#   weights (UD-Q8_K_XL)             29.3 GiB
#   KV @ 262,144 tok, q8_0 K+V        8.5 GiB
#   vision projector (mmproj F16)     0.9 GiB
#   compute buffers @ ubatch 1024    ~2   GiB
#   ------------------------------------------
#   total                            ~41 GiB / 108 GiB GTT
#
# On this machine you would normally run BF16 (qwen3.8-27b) since the memory is
# there; use this config when you specifically want non-thinking output and are
# willing to trade weight precision for it, or when serving several clients --
# the ~67 GiB of slack supports a high PARALLEL comfortably.
#
# This file also stops the instruct config falling back to the card-generic
# 131072 default in profiles/strixhalo/default.env.
: "${CTX_SIZE:=262144}"
: "${UBATCH:=1024}"
