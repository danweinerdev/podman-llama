# GPU-fit tuning: latest text-only Qwen3.8-27B UD-Q8_K_XL on 2x R9700 ROCm/RCCL.
#
# Approximate combined-VRAM arithmetic at 262,144 tokens (runtime allocation
# must be measured): 29.30 GiB weights + ~8.5 GiB q8_0 K+V KV = ~37.8 GiB,
# leaving ~24.2 GiB of the ~62 GiB pair before runtime/compute allocations.
# No MTP is enabled here: this is the raw tensor-parallel A/B baseline.
: "${CTX_SIZE:=262144}"
: "${UBATCH:=1024}"
: "${BATCH:=1024}"
: "${FLASH_ATTN:=on}"
: "${CACHE_TYPE_K:=q8_0}"
: "${CACHE_TYPE_V:=q8_0}"
