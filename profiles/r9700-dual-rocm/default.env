# Machine profile: 2x AMD Radeon AI PRO R9700 (gfx1201, RDNA4, ~31 GiB VRAM each)
#
# Experimental ROCm/RCCL tensor-parallel A/B path for one model across both
# dedicated-VRAM cards. This is deliberately separate from profiles/r9700-dual,
# whose working Vulkan profiles must remain the compatibility baseline.
#
# Tensor split distributes weights and KV across both GPUs, unlike the Vulkan
# layer-mode baseline. Start balanced: the Qwen3.8 Q6/Q8 fits leave ample
# arithmetic slack, so there is no display-card bias initially.
# Tensor mode and RCCL are experimental. If ROCm, KFD, or RCCL fails, fall back
# to the existing Vulkan profile or a layer split on a working backend.

: "${IMAGE:=llama-r9700:rocm}"
: "${PORT:=18080}"                          # host port; container still listens on 8080
: "${GFX_OVERRIDE:=}"                       # native gfx1201, no HSA override
: "${ENABLE_UMA:=0}"                        # dedicated VRAM, never use UMA here
: "${ROCR_VISIBLE_DEVICES:=0,1}"
: "${HIP_VISIBLE_DEVICES:=0,1}"

# ROCm HSA model uploads require host-memory mappings that Fedora SELinux's
# container label blocks on this machine (reported as "Reason: Memory in use").
# Disable SELinux labeling only for this dedicated ROCm profile; the launcher
# still applies no-new-privileges and drops all Linux capabilities.
: "${DISABLE_SELINUX_LABEL:=1}"

# Experimental tensor mode splits weights and KV; 1,1 is a throughput baseline.
: "${SPLIT_MODE:=tensor}"
: "${TENSOR_SPLIT:=1,1}"
LLAMA_ARGS+=(--split-mode "${SPLIT_MODE}" --tensor-split "${TENSOR_SPLIT}" --poll 0 --no-kv-unified)
# --poll 0 reduces CPU polling overhead; it is not a claimed decode-speed gain.

: "${CTX_SIZE:=32768}"
: "${UBATCH:=1024}"
: "${BATCH:=1024}"
: "${THREADS:=8}"
: "${NO_MMAP:=0}"                           # dedicated VRAM; retain mmap under rootless memlock limits
